#!name=AITO HA 授权采集
#!desc=被动收集 AITO 授权字段，通过 Surge 面板核对并复制；不主动登录或控制车辆。
#!system=mac

[MITM]
hostname = %APPEND% omp.uopes.cn, apig.fgaiservice.com

[Script]
aito_ui_request = type=http-request,pattern=^https://(?:omp\.uopes\.cn/xcar/omp/xbs/account/(?:user|vehicle)/(?:auth|refresh)|apig\.fgaiservice\.com/vcam/v1/accounts/vehicles)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/VectorZhao/AITO-Surge/main/aito.js,requires-body=true,full-header-mode=true,max-size=1048576
aito_ui_response = type=http-response,pattern=^https://(?:omp\.uopes\.cn/xcar/omp/xbs/account/(?:user|vehicle)/(?:auth|refresh)|apig\.fgaiservice\.com/vcam/v1/accounts/vehicles)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/VectorZhao/AITO-Surge/main/aito.js,requires-body=true,full-header-mode=true,max-size=1048576
aito_ui_panel = type=generic,script-path=https://raw.githubusercontent.com/VectorZhao/AITO-Surge/main/aito.js
aito_ui_monitor = type=cron,cronexp="* * * * *",script-path=https://raw.githubusercontent.com/VectorZhao/AITO-Surge/main/aito.js

[Panel]
AITO_Authorization = title="AITO 授权",content="点击刷新暂停并复制",style=info,script-name=aito_ui_panel
AITO_Reset = title="AITO 新一轮",content="点击刷新清空本轮并开始",style=info,script-name=aito_ui_panel
